TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key
# Pick a non-reasoning chat model — reasoning models burn the token budget on
# internal thinking and return empty content. See OpenRouter for current options.
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
DATABASE_PATH=./pocoapoco.db
LOG_LEVEL=INFO
# Shared secret required to join the bot. Pick something unguessable.
# Users join via t.me/<botname>?start=<INVITE_CODE> or by sending "/start <INVITE_CODE>".
INVITE_CODE=change_me_to_something_unguessable
# Weekly Premium price in Telegram Stars. 0 = free during beta (toggle UX).
# Non-zero enables a Stars subscription invoice; charged as 4× this value every
# 30 days (Telegram Stars only supports a 30-day subscription period).
PREMIUM_PRICE_STARS_PER_WEEK=0
